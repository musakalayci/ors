değer Sürüm *t8 = '0.0.0';
değer Yazılım *t8 = 'örs';


Derleme *t 
küresel iş TürEkle Tür *imge::cins::t 
{
  durum Tür->özellik.türü: 
  {
    seçim imge::cins::Özellik::Yapıtaşı: 
    seçim imge::cins::Özellik::Sayaç:  
    seçim imge::cins::Özellik::İşlem: 
    seçim imge::cins::Özellik::Kalıp: 
      Derleme->türler.sanallar.Ekle(Tür);
    
    seçim imge::cins::Özellik::DonatılmışYalın,
          imge::cins::Özellik::Yaban,
          imge::cins::Özellik::Varsayılan,
          imge::cins::Özellik::Ortak:

      Derleme->türler.çizelge.Ekle(Tür);
    varsayılan:
      //Hafıza := &Derleme->hafıza;
     // Tür->Atıflar = <%Tür->Atıflar>Hafıza->Yeni(@*Tür->Atıflar, @mimari);
      //Tür->Atıflar->Yapılandır(Hafıza);
      Derleme->türler.çizelge.Ekle(Tür);
  }
}


Derleme *t 
küresel iş BölümEkle Bölüm *bölüm::t 
{
  eğer Bölüm->no > 1: 
    Derleme->bölümler.Ekle(Bölüm);
}


küresel iş Başlat 
argümanSayısı tam, _argümanlar **t8 
{
  Derleme := temiz(t); 
 
  Derleme->yapılandır(argümanSayısı, _argümanlar); 

  Derleme->Başlat();  
  Derleme->Temizle(); 
  sil Derleme; 
