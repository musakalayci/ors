Çözümleme *t 
iş _ileti : *imge::t 
{
  İleti := imge::_ileti::Yeni(Çözümleme->hafıza());
  Çözümleme->sıradaki();
  durum Çözümleme->şuanki()->özellik:
  {
    seçim simge::Özellik::İki_Nokta:
      Çözümleme->sıradaki();
    varsayılan:
      dön Çözümleme->Hataİmla(
        "İleti satırı için beklenmeyen simge");
  }
  İlk := Çözümleme->önİfade(); 
  durum İlk->özellik: 
  {
    seçim imge::Özellik::Metin:
      İleti->Metin = İlk->içerik.İfade->içerik.Metin; 
    varsayılan: 
      dön Çözümleme->Hataİmla(
        "İleti satırı metin ifadesi bekleniyor.");
  }
  durum Çözümleme->şuanki()->özellik: 
  {
    seçim simge::Özellik::Sayı:
      İleti->seviye = Çözümleme->şuanki()->içerik.sayı.Tam();
    seçim simge::Özellik::Virgül: 
    seçim simge::Özellik::Noktalı_Virgül: 
      Çözümleme->sıradaki();
  }
  i::Yaz("iletiiiiiiiiiiiiiii: %d, %s\n", İleti->Öz->özellik, İleti->Metin->_harfler, İleti->seviye);
  dön İleti->Öz;
}


Çözümleme *t 
iş tekSatır : *imge::t
{
  değer İmge *imge::t = boş;
  durum Çözümleme->şuanki()->özellik:
  {
    seçim simge::Özellik::Yorum: 
      Çözümleme->sıradaki();
      tekrar;
    seçim simge::Terim::İleti:
      dön Çözümleme->_ileti(); 
    seçim simge::Özellik::Küme_Aç:
      dön Çözümleme->dağarcık();
    seçim simge::Terim::Eğer:
      dön Çözümleme->_eğer(); 
    seçim simge::Terim::Tüm:
      dön Çözümleme->_tüm();
    seçim simge::Terim::Her:
      dön Çözümleme->_her();
    seçim simge::Terim::Durum:
      dön Çözümleme->_durum();
    seçim simge::Terim::Dön:
      İmge = Çözümleme->_dön(); 
    seçim simge::Terim::Sil:
      İmge = Çözümleme->_sil(); 
    seçim simge::Terim::Boşalt:
      İmge = Çözümleme->_boşalt();
    seçim simge::Terim::Seçim,
          simge::Terim::Tekrar,
          simge::Terim::Son, 
          simge::Terim::Git, 
          simge::Terim::Devam,
          simge::Terim::Geç:
      dön Çözümleme->Hataİmla("Tekil satır için beklenmeyen simge.");
    varsayılan:
      İmge = Çözümleme->ifade(0);
      durum İmge->özellik:
      {
        seçim imge::Özellik::Hata:
          dön İmge;
      }
  }

  durum Çözümleme->şuanki()->özellik: 
  {
    seçim simge::Özellik::Noktalı_Virgül:
      İmge->KonumSonuGüncelle(Çözümleme->şuanki());
      Çözümleme->sıradaki();
    varsayılan:
      dön Çözümleme->Hataİmla(
        "Satır sonu için noktalı virgül bekleniyor.");
  }
  dön İmge;
}


Çözümleme *t 
iş satır : *imge::t
{
  değer İmge *imge::t = boş;
  durum Çözümleme->şuanki()->özellik:
  {
    seçim simge::Terim::İleti:
      dön Çözümleme->_ileti(); /*
    seçim simge::Terim::Değer:
      İmge = Çözümleme->_değer(); */
    seçim simge::Özellik::Küme_Aç:
      dön Çözümleme->dağarcık();
    seçim simge::Terim::Eğer:
      dön Çözümleme->_eğer(); 
    seçim simge::Terim::Tüm:
      dön Çözümleme->_tüm();
    seçim simge::Terim::Her:
      dön Çözümleme->_her();
    seçim simge::Terim::Durum:
      dön Çözümleme->_durum();
    seçim simge::Terim::Git:
      İmge = Çözümleme->_git(); 
    seçim simge::Terim::Son,
          simge::Terim::Devam:
      İmge = Çözümleme->içGit();
    seçim simge::Terim::Dön:
      İmge = Çözümleme->_dön(); 
    seçim simge::Terim::Sil:
      İmge = Çözümleme->_sil(); 
    seçim simge::Terim::Boşalt:
      İmge = Çözümleme->_boşalt(); 
    seçim simge::Terim::Tekrar:
      Çözümleme->sıradaki(); 
      İGit := imge::kesit::YeniİçGit(
        Çözümleme->hafıza(),
        boş,
        imge::Özellik::Tekrar); 
      İmge = İGit->Öz;
    seçim simge::Terim::Seçim,
          simge::Terim::Geç:
      dön Çözümleme->Hataİmla("Satır için beklenmeyen si?mge.");
    varsayılan:
      İmge = Çözümleme->ifade(0);
      durum İmge->özellik:
      {
        seçim imge::Özellik::Hata:
          dön İmge;
      }
  }

  durum Çözümleme->şuanki()->özellik: 
  {
    seçim simge::Özellik::Noktalı_Virgül:
      İmge->KonumSonuGüncelle(Çözümleme->şuanki());
      Çözümleme->sıradaki();
    varsayılan:
      dön Çözümleme->Hataİmla(
        "Satır sonu için noktalı virgül bekleniyor.");
  }
  dön İmge;
}

