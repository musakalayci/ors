Üretim *t 
küresel iş çeviri İmge *imge::t, yükle tam: *nesne::t  
{
  Çeviri := İmge->içerik.Temel; 
  Özet := Çeviri->Sol->içerik.TürÖzeti; 
  Hafıza := Üretim->Bölüm->Hafıza; 
  düşür := 0; 
  durum Özet->Gösterge->özellik: 
  {
    seçim imge::Özellik::İşlemKonumu: 
    seçim imge::Özellik::TürAlma: 
      düşür = 1;
  } 
  
  YeniÖzet := Özet->İkile(Hafıza, Özet->Gösterge, Özet->derece); 
  YeniÖzet = YeniÖzet->Yapılandır(Üretim->Bölüm); 
  derece := YeniÖzet->Öz->nesne.Derece();
  koşul := ( derece > 1);


    Üretim->Bölüm->Genel()->Yaz("\n;başladık ?\n");
  eğer düşür && koşul: 
  {
    YeniÖzet->derece--; 
    YeniÖzet->Öz->nesne.Düşür(); 
  }

  Gelen    := Üretim->ifade(Çeviri->Sağ, hayır); 
  makina := Gelen->Makina();
  işlem := 0;
  durum Gelen->Makina(): 
  {
    seçim nesne::Makina::Hata: 
      dön Gelen; 
    seçim 
      nesne::Makina::SanalÇağrı: 
      //i::Yaz("Gelen _ %p\n", Gelen);
    seçim nesne::Makina::KonumTür:
      //derece--;
      kk := (Gelen->Derece() > 1);
      
      eğer yükle: 
        Gelen = Gelen->Yükle(Üretim);
      değilse: 
      {
        YeniÖzet->Öz->nesne.Yükselt();
        işlem = nesne::Makina::ÇeviriTürErişim;
      }
    seçim nesne::Makina::KonumAlma:
      /*eğer !yükle:
      {
        Son := Üretim->yığın.çeviri.Son();
        eğer Son == boş: 
          YeniÖzet->Öz->nesne.Yükselt();
      }*/
    seçim nesne::Makina::Yarat:

    seçim nesne::Makina::Çağrı,
      nesne::Makina::İçSabit, 
      nesne::Makina::ÇeviriYapıtaşı,
      nesne::Makina::Karşılaştırma,
      nesne::Makina::ÇeviriKonum:
    seçim nesne::Makina::Yükleme:
    varsayılan: 
      eğer yükle: 
        Gelen = Gelen->Yükle(Üretim);
      eğer !Gelen: 
      { 
        i::Acil("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
      }
  }
  
  Üretim->Bölüm->Genel()->Yaz("\n;düşürülmüş mü %d, %d, %d, %d, %d, %p?\n",
    düşür, koşul, yükle, makina, derece, Üretim->yığın.çeviri.Son());
  
  durum Çeviri->Sağ->Sıradaki(): 
    {
      seçim imge::Özellik::TürErişim,
            imge::Özellik::KonumErişim:
        yükle = evet;
        
    }
  
  
  eğer !Gelen: 
    dön bildiri::Nesne(
      Üretim->Bölüm->Kaynak, 
      bildiri::Üretim::Çeviri, 
      &İmge->konum,
      "Hatalı çeviri"); 
  Çevirilmiş := Gelen->Çeviri(Üretim, &YeniÖzet->Öz->nesne);
  eğer işlem: 
    Çevirilmiş->İşlemlendir(işlem);
  dön Çevirilmiş;
}

Üretim *t 
küresel iş beklenenÇeviri Sol *nesne::t, Sağ *nesne::t : *nesne::t  
{
  
  fark := Sol->Derece() - Sağ->Derece(); 
  
  eğer fark == 1: 
  {
    eğer Sol->Özet->YapıtaşıMı() && Sağ->Özet->YapıtaşıMı(): 
    {
      eğer Sol->Özet->No() != Sağ->Özet->No(): 
        dön Sağ->YapıtaşıÇeviri(Üretim,  Sol->Özet->No());
    }
  }
  dön Sağ;
}