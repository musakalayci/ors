}

ortak içerik 
{
  Tür   şey; 
  İşlem şey;
  İmge  şey;
}

ortak nolar 
{
  hepsi mimari; 
  sol   tam; 
  sağ   tam;
}


tür argüman 
{
  özellik   tam;
  no        tam; 
  şeyMi     tam; 
  derece    tam; 
  diziFarkı tam; 
  Özet      *imge::cins::özet;
  Nesne     *nesne::t;
  içerik    içerik;
}

tür fark 
{
  istenen tam; 
  olan    tam;
}

tür t 
{
  aşama     t32;
  işlem     tam;
  nolar     nolar;
  sol       argüman; 
  sağ       argüman; 
  fark      fark;
  Konum    *imge::t;
  Üretim   *üretim::t;
}

küresel iş Yeni Üretim *üretim::t: *t 
{
  Hafıza := Üretim->Kaynak->Hafıza;
  Denetleme := <*t>Hafıza->Yeni(@t, @mimari); 
  Denetleme->Üretim = Üretim;
  dön Denetleme;
}

Denetleme *t 
küresel iş Yapılandır
  Konum  *imge::t, 
  Sol *nesne::t, 
  Sağ    *nesne::t 
{
  Denetleme->Konum = Konum; 
  Denetleme->sağ.Nesne = Sağ;
  Denetleme->sol.Nesne = Sol; 
  Denetleme->sağ.no       = Sağ->Özet->No();
  Denetleme->sol.no    = Sol->Özet->No();
  solDerece := Sol->Derece(); 
  sağDerece    := Sağ->Derece();
  Denetleme->fark.olan = (seç Denetleme->aşama: 
    Aşama::SanalÇağrı: sağDerece - solDerece,
    varsayılan:        solDerece - sağDerece);
  Denetleme->sol.derece = solDerece; 
  Denetleme->sol.Özet   = Sol->Özet;
  Denetleme->sağ.derece    = sağDerece; 
  Denetleme->sağ.Özet      = Sağ->Özet; 
}





Denetleme *t 
küresel iş Derece beklenenFark tam : *nesne::t 
{
  SağÖzet    := Denetleme->sağ.Özet; 
  SolÖzet := Denetleme->sol.Özet; 
  eğer SağÖzet->HiçMi(): 
    dön boş; 
  eğer Denetleme->fark.olan != Denetleme->fark.istenen: 
  {
    durum Denetleme->aşama: 
    {
      seçim Aşama::SanalÇağrı:
      varsayılan: 
        
        dön Denetleme->sağ.Nesne;
    }
  }
  dön boş; 
}

Denetleme *t 
küresel iş Tür : *nesne::t  
{
  değer Sonuç *nolar = &Denetleme->nolar; 
  sol := Denetleme->sol.no; 
  sağ := Denetleme->sağ.no; 
  eğer sağ == simge::Terim::Boş: 
    dön boş; 
  eğer sol != sağ: 
  {
    s1 := sol < simge::Terim::Metin; 
    s2 := sağ < simge::Terim::Metin;
    eğer s1 && s2: 
      dön Denetleme->Yapıtaşı();
    değilse: 
    {
      durum Denetleme->aşama: 
      {
        seçim Aşama::Çağrı: 
          durum sağ: 
          {
            seçim simge::Terim::DeğişkenArgüman: 
              dön boş; 
          }
          geç;
        varsayılan: 
          Denetleme->Üretim->Bellekler->ilk.Sıfırla();
          SolDöküm := Denetleme->sol.Nesne->Döküm(
            Denetleme->Üretim, 
            &Denetleme->Üretim->Bellekler->ilk);
          Denetleme->Üretim->Bellekler->ikinci.Sıfırla();
          SağDöküm := Denetleme->sağ.Nesne->Döküm(
            Denetleme->Üretim, 
            &Denetleme->Üretim->Bellekler->ikinci);
          dön bildiri::Nesne(
            Denetleme->Üretim->Bölüm->Kaynak, 
            bildiri::Denetleme::Tür, 
            &Denetleme->Konum->konum,
            "Tür uyumsuzluğu. %d %s, %d %s", 
            sol, SolDöküm->_veri, sağ, SağDöküm->_veri);
      }
    }
  }
  dön boş;
}



Denetleme *t 
küresel iş Nesne : *nesne::t 
{
  Gelen := Denetleme->Tür();
  eğer Gelen: 
    dön Gelen; 
  
  Gelen = Denetleme->Derece(1); 
  eğer Gelen: 
    dön Gelen;
  dön boş; 
}

