birim _ileti 
{
  dahili örs::derleme::hafıza;
  tür t 
  {
    Öz     *imge::t;
    Metin  *metin;
    seviye  d64;
  } 

  küresel iş Yeni Hafıza *hafıza::t: *t 
  {
    İmge  := imge::Yeni(Hafıza);
    İmge->özellik = imge::Özellik::İleti;
    İleti := <*t>Hafıza->Yeni(@t, @mimari);
    İleti->Öz          = İmge;
    İmge->içerik.İleti = İleti;
    dön İleti;
  }
}