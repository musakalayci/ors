Tür *t 
iş atıflandır Gösterge *imge::t 
{
  Bölüm := Tür->Öz->Kütüphane->Bölüm; 
  değer Gözet  *özet = boş;
  durum Gösterge->özellik: 
  {
    seçim imge::Özellik::Sayaç:
    seçim imge::Özellik::İşlemKonumu: 
   //   i::Yaz("iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii");
      Konum := Gösterge->içerik.İşlemKonumu; 
      DeğişkenÖzeti := Konum->Çıktı; 
      eğer DeğişkenÖzeti: 
      {
        Tür->atıflandır(DeğişkenÖzeti->Gösterge);
      }
      boyut := Konum->girdi.boyut; 
      her i := 0; i < boyut; i++: 
      {
        DeğişkenÖzeti = Konum->girdi.Nesneler[i];
        Tür->atıflandır(DeğişkenÖzeti->Gösterge);
      }
    seçim imge::Özellik::Arama, 
          imge::Özellik::Saf: 
      Gelen := imge::cins::Arama(Bölüm, Gösterge);
      eğer Gelen: 
      {
        durum Gelen->özellik: 
        {
          seçim imge::Özellik::Tür: 
            GelenTür := Gelen->içerik.Tür; 
            eğer GelenTür->no != Tür->no: 
            {
              /*
                Gelen->içerik.Tür->gelenAtıflar++; 
                Tür->Atıflar->Ekle(Gelen->içerik.Tür);*/
              durum GelenTür->özellik.türü: 
              {
                seçim Özellik::Yalın: 
                  Tür->gelenAtıflar++; 
                  GelenTür->Atıflar->Ekle(Tür); 

                  
                  eğer Gelen->nesne.Özet->Taç: 
                  {
                    Taç := Gelen->nesne.Özet->Taç; 
                    her i := 0; i < Taç->boyut; i++: 
                    {
                      Gözet = Taç->_donatım[i];
                      //Bölüm->Hafıza->Derleme->Döküm->İmge(Taç->_donatım[i]->Gösterge, 0, ',');
                  //  i::Yaz("olmuyor mu ? %p\n", Gözet);
                      GelenTür->atıflandır(Taç->_donatım[i]->Gösterge);
                    }
                  }
                //  Tür->atıflandır(Gelen->nesne.Özet->Gösterge);
                seçim Özellik::DonatılmışYalın: 
                  i::Yaz("bulundu mu ? %s\n", Gelen->Ad->_harfler);
                varsayılan: 
                //  i::Yaz("bulundu mu ? %s, %d\n", Gelen->Ad->_harfler, GelenTür->özellik.türü);
                  Tür->gelenAtıflar++; 
                  Gelen->içerik.Tür->Atıflar->Ekle(Tür);
              }
                  
            }
                /*Gelen->içerik.Tür->gelenAtıflar++; 
                Tür->Atıflar->Ekle(Gelen->içerik.Tür);*/
        }
      }
  }
}

Tür *t 
küresel iş Atıflandır 
{
  değer Özet     *özet              = boş; 
  değer Gösterge *imge::t           = boş;
  değer Değişken *imge::değişken::t = boş; 
  değer AltTür   *t                 = boş;
  
  durum Tür->özellik.türü: 
  {
    seçim Özellik::Varsayılan: 
      her i := 0; i < Tür->Üyeler->boyut; i++: 
      {
        Değişken = Tür->Üyeler->Nesneler[i]->içerik.Değişken; 
        Özet     = Değişken->Özet;
        Gösterge = Özet->Gösterge;
        Tür->atıflandır(Gösterge);
      }
    varsayılan: 
      Tür->gelenAtıflar = 0; 
  }
}