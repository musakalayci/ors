
Nesne *t
küresel iş Yükle Üretim *üretim::t : *t 
{
  
  eğer !Nesne: 
    dön boş;
  eğer !Nesne->Özet:
    {
      i::Yaz("boş !!! %p, %p, %p, {%p, %p}\n", 
        Nesne->Öz, Nesne->Atıf, Nesne->Öz->içerik.İfade, 
        Nesne->Özet, Nesne->Atıf->nesne.Özet); 
      /*Üretim->Derleme->Döküm->İmge((<*imge::dağarcık::t>
        Nesne->Öz->Dağarcık)->Öz, 0, '\n'); 
      Üretim->Derleme->Döküm->İmge((<*imge::dağarcık::t>
      Nesne->Atıf->Dağarcık)->Öz, 0, '\n');*/
      dön boş;
    }
  eğer Nesne->Özet->Dizi:
  {
    eğer (Nesne->Derece() == 1): 
      dön Nesne;
  }

  eğer Nesne->no < 0: 
    dön Nesne;
  durum Nesne->Makina(): 
  {
    seçim Makina::İkiz: 
      dön Nesne;
    seçim Makina::Geç: 
      dön Nesne;
  }
  durum Nesne->Atıf->özellik: 
  {
    seçim imge::Özellik::SabitSayı,
          imge::Özellik::Sayı: 
      dön Nesne; 
    seçim imge::Özellik::SanalAtıf: 
      Nesne = &Nesne->Atıf->nesne;
  }
  
  Çıktı     := nesne::Yeni(Üretim->Bölüm->Hafıza, Nesne->Öz, 0); 
  Çıktı->Nakil(Nesne);
  Çıktı->Öz  = Nesne->Öz; 

  Yüklenmemiş := Üretim->TürdenİlkArgümana(Çıktı);
  Ad        := &Üretim->Bellekler->ad;
  d         := Üretim->Değer();
  derece    := Çıktı->Düşür();
  Yüklenmiş := Üretim->TürdenİkinciArgümana(Çıktı);
  
  Ad->Sıfırla();
  
  sıralama          := Çıktı->Sıralama();  
  durum Nesne->Kök(): 
  {
    seçim nesne::KökDeğer::Küresel,
      nesne::KökDeğer::Dış: 
      Ad->Yaz('@%s', Çıktı->Metin->_harfler);
      Çıktı->Anlamlandır(Anlam::Değer);
      Çıktı->İşlemlendir(Makina::Geç);
    varsayılan: 
      Ad->Yaz('%%%d', Çıktı->no);
      Çıktı->İşlemlendir(Makina::Yükleme);
  }
  eğer !sıralama: 
  {
    i::Acil("mümkün değil !!");
  }
  eğer Üretim->AyıklamalıMı(): 
    Üretim->Bölüm->Ayıklama->Yükleme(Nesne, &Üretim->Bellekler->ikinci);
  Çıktı->özellik.kök = 0; 
  Üretim->Bölüm->Genel()->Yaz(
    "  %%%d = load %s, %s %s, align %d%s;\n",
      d,
      Yüklenmiş->_veri, 
      Yüklenmemiş->_veri, 
      Ad->_veri, sıralama,
      (seç Üretim->AyıklamalıMı(): 
        evet : Üretim->Bellekler->ikinci->_veri, 
        varsayılan: ' '), );
  Çıktı->no = d; 
Çıktı->Anlamlandır(Anlam::Değer);
  dön Çıktı;   
}