

Nesne *t 
küresel iş Seçim Üretim *üretim::t : *nesne::t 
{
  Hafıza := Üretim->Bölüm->Hafıza;

  //hafıza::küme::çizelge::örnek::Başlat(Hafıza);
  Durum := Nesne->Öz->içerik.Durum; 
  no    := Nesne->no;
  değer _varsayılan *t8 = boş; 
  VarsayılanBedeni := Durum->VarsayılanKesit;  
  eğer Durum->Varsayılan: 
  {
    _varsayılan = VarsayılanBedeni->Öz->Ad->_harfler;
  }
  değilse: 
    _varsayılan = Durum->Son->Öz->Ad->_harfler;
  İfade := Üretim->ifade(Durum->Taç, evet);
  eğer İfade->Hatalıİse(): 
    dön İfade;
    
  değer çizelge merkez::küme::çizelge::i = {};
  çizelge.Yapılandır(16);

  _Tür := Üretim->TürdenArgümana(İfade, &Üretim->Bellekler->ikinci);
  Üretim->Bölüm->Genel()->Yaz("  switch %s %%%d, label %%%s [\n", 
    _Tür->_veri, İfade->no, _varsayılan);
  //i::Yaz("türler                : '%s'\n", _Tür->_veri);
  değer Gelen   *nesne::t = boş;
  değer Satır   *imge::t = boş; 
  değer Şuanki  *imge::t = boş;
  değer Bulunan *imge::t = boş; 
  değer Seçim   *imge::_durum::seçimİfade = boş; 
  Satırlar := &Durum->Dağarcık->satırlar;
  seçimlerBoyutu := Satırlar->boyut; 
  s := 0; 
  değer _geçici *t8 = 'geçici';



  

  her i := 0; i < seçimlerBoyutu; i++: 
  {
    Satır = Satırlar->Nesneler[i];
    Seçim = Satır->içerik.Seçimİfade;
    sno := Üretim->Dağarcık(); 
    Üretim->Bellekler->ilk.Sıfırla();
    Üretim->Bellekler->ilk.Yaz('secim.ox%x.ox%x', no, sno);
    SeçimBedeni := imge::kesit::Kesit(Hafıza, Satır, &Üretim->Bellekler->ilk);  
    Seçim->Kesit = SeçimBedeni; 
    eğer Seçim->sabitler.boyut: 
    {
      Uğranan := Seçim->sabitler.Baş; 
      her Uğranan; Uğranan = Uğranan->Sonraki: 
      {
        Şuanki = Uğranan->Öz; 
        Üretim->Bellekler->ilk.Sıfırla();
        durum Şuanki->özellik: 
        {
          seçim imge::Özellik::Sayı: 
            s = Şuanki->içerik.sayı.Tam();
            Gelen := çizelge.Ara(s); 
            eğer Gelen: 
            {
              çizelge.Temizle();
              dön bildiri::Nesne(
                Üretim->Bölüm->Kaynak, 
                bildiri::Üretim::Beklenmeyen, 
                &Seçim->Öz->konum,
                "Seçim tekrarı.\n");
            }

              çizelge.Ekle(s, _geçici);
            Şuanki->içerik.sayı.Çıktı(
              simge::Terim::T32,
              &Üretim->Bellekler->ilk);
            Üretim->Bölüm->Genel()->Yaz("    %s %s, label %%%s\n",
              _Tür->_veri,
              Üretim->Bellekler->ilk._veri, 
              SeçimBedeni->Öz->Ad->_harfler);

          seçim imge::Özellik::SabitSayı: 
            s = Şuanki->içerik.sabitSayı;
            Gelen := çizelge.Ara(s); 
            eğer Gelen: 
            {
              çizelge.Temizle();
              dön bildiri::Nesne(
                Üretim->Bölüm->Kaynak, 
                bildiri::Üretim::Beklenmeyen, 
                &Seçim->Öz->konum,
                "Seçim tekrarı.\n");
            }

            çizelge.Ekle(s, _geçici);
            Üretim->Bölüm->Genel()->Yaz("    %s %ld, label %%%s\n",
              _Tür->_veri,
              Şuanki->içerik.sabitSayı, 
              SeçimBedeni->Öz->Ad->_harfler); 
          seçim imge::Özellik::Arama: 
            Bulunan := Üretim->Aramaİfadesi(Şuanki);
            eğer !Bulunan: 
            {
              çizelge.Temizle();
              dön bildiri::Nesne(
                Üretim->Bölüm->Kaynak, 
                bildiri::Üretim::Beklenmeyen, 
                &Şuanki->konum,
                "Seçim satırı için sonuçsuz arama.\n"); 
            }
            Şuanki = Bulunan;
            tekrar;
          seçim imge::Özellik::SayaçKümesiİşlenmiş:
            Küme := Şuanki->içerik.İfade->içerik.Dağarcık; 
            Ast := Küme->Üyeler->Baş; 
            Üye := Şuanki;
            //  i::Yaz("türler: '%s'\n", _Tür->_veri);
            her Ast: 
            {
              Üye = Ast->Öz; 
              s = Üye->içerik.sayı.Tam(); 
              Gelen := çizelge.Ara(s); 
              eğer Gelen: 
              {
                çizelge.Temizle();
                dön bildiri::Nesne(
                  Üretim->Bölüm->Kaynak, 
                  bildiri::Üretim::Beklenmeyen, 
                  &Seçim->Öz->konum,
                  "Sayaç kümesi için seçim '%d' %p, %d tekrarı.\n", s, Gelen, Üye->içerik.sayı.içerik._t32);
              }
              çizelge.Ekle(s, _geçici);
              Üye->içerik.sayı.Çıktı(
              simge::Terim::T32,
              &Üretim->Bellekler->ilk);
              Üretim->Bölüm->Genel()->Yaz("    %s %s,         label %%%s\n",
                _Tür->_veri,
                Üretim->Bellekler->ilk._veri, 
                SeçimBedeni->Öz->Ad->_harfler);
              Ast = Ast->Sonraki; 
            }
            
          varsayılan: 
            çizelge.Temizle();
            dön bildiri::Nesne(
              Üretim->Bölüm->Kaynak, 
              bildiri::Üretim::Beklenmeyen, 
              &Şuanki->konum,
              "Seçim satırı için beklenmeyen imge.\n");
        }
      }
    }
  }
  Bellek := &Üretim->AyıklamaKonum(Durum->Öz);
  Üretim->Bölüm->Genel()->Yaz("  ]%s\n", Bellek->_veri);
  çizelge.Temizle();
  dön Nesne;
}