dahili örs::derleme::imge::kesit; 

Nesne *t 
küresel iş SıfıraKarşılaştırma Üretim *üretim::t: *nesne::t 
{
  Sonuç := nesne::Yeni(Üretim->Bölüm->Hafıza, Nesne->Öz, nesne::Anlam::Makina); 
  Sonuç->Nakil(Nesne);
  Sonuç->no = Üretim->Değer();
  İlk := Üretim->İlkArgüman(Nesne); 
  Üretim->Bölüm->Genel()->Yaz("  %%%d = icmp ne %s, %s\n",
    Sonuç->no, 
    İlk->_veri, 
    (seç Nesne->Derece(): 
      0: '0',
      varsayılan: 'null'));
  Özet := Üretim->Derleme->YapıtaşıÖzeti(simge::Terim::EH);
  Sonuç->Özet = Özet;
  Sonuç->özellik.derece = 0;
  Sonuç->İşlemlendir(Makina::Karşılaştırma);
  dön Sonuç;
}

Nesne *t 
küresel iş Karşılaştırma Üretim *üretim::t, Sağ *nesne::t, işlem tam: *nesne::t 
{
  _işlem := (seç işlem: 
    simge::Özellik::Küçüktür: 'slt',
    simge::Özellik::Büyüktür: 'sgt',
    simge::Özellik::Büyük_Eşit: 'sge',
    simge::Özellik::Küçük_Eşit: 'sle',
    simge::Özellik::Eşit_Değildir: 'ne',
    simge::Özellik::Eşittir:       'eq',
    varsayılan: 'null');
  Sonuç := nesne::Yeni(Üretim->Bölüm->Hafıza, Sağ->Öz, nesne::Anlam::Makina); 
  Sonuç->Nakil(Nesne);
  Sonuç->no = Üretim->Değer();
  İlk := Üretim->İlkArgüman(Nesne);
  İkinci := Üretim->İkinciYalın(Sağ);
  Üretim->Bölüm->Genel()->Yaz("  %%%d = icmp %s %s,%s\n",
    Sonuç->no, 
    _işlem, 
    İlk->_veri, 
    İkinci->_veri);
  Özet := Üretim->Derleme->YapıtaşıÖzeti(simge::Terim::EH);
  Sonuç->Özet = Özet;
  Sonuç->özellik.derece = 0;
  Sonuç->İşlemlendir(Makina::Karşılaştırma);
  dön Sonuç;
}

Nesne *t 
küresel iş Değil Üretim *üretim::t : *nesne::t 
{
  Sonuç := nesne::Yeni(Üretim->Bölüm->Hafıza, Nesne->Öz, nesne::Anlam::Makina); 
  Sonuç->Nakil(Nesne);
  d := Üretim->Değer();
  d2 := Üretim->Değer();
  İlk := Üretim->İlkArgüman(Nesne);
  Üretim->Bölüm->Genel()->Yaz(
    "  %%%d = icmp ne %s, %s\n"
    "  %%%d = xor i1 %%%d, true\n",
    d, 
    İlk->_veri, 
    (seç (Nesne->Derece()): 
      0: '0',
      varsayılan: 'null'), d2, d);
  

  Özet := Üretim->Derleme->YapıtaşıÖzeti(simge::Terim::EH);
  Sonuç->Özet = Özet;
  Sonuç->no = d2;
  Sonuç->özellik.derece = (0);
  Sonuç->İşlemlendir(Makina::Karşılaştırma);
  dön Sonuç;
}

küresel iş mantıkÇıktısı Üretim *üretim::t, Girdi *imge::in, Son *imge::in, koşul tam : *imge::t 
{
  değer İmge *imge::t = Girdi->Öz;
  durum İmge->özellik: 
  {
    seçim imge::Özellik::I_Pi: 
       Pi := İmge->içerik.Pi; 
      // i::Acil("neler oluyor yaaaaaaaaaaaaaaaaaaaaaaâ\n");
       eğer Son: 
       {
         Üretim->Bölüm->Genel()->Yaz(
        " [%s, %%%s],",
        (seç koşul: evet: 'true', varsayılan: 'false'),
        Pi->Son->Öz->Ad->_harfler); 
       }
       değilse: 
       {
          Üretim->Bölüm->Genel()->Yaz(
          " [%%%d, %%%s]",
          Pi->Son->İn->Nesne->no,
          Pi->Son->Öz->Ad->_harfler); 
       }
      dön İmge;
    seçim imge::Özellik::I_PiGeç:
      Pi := İmge->içerik.Pi; 
      Kutu := İmge->içerik.Pi->Pinler->Baş; 
      eğer Pi->koşul < koşul: 
      {
       // i::Acil("neler oluyor yaaaaaaaaaaaaaaaaaaaaaaâ\n");
        Üretim->Bölüm->Genel()->Yaz(
        " [%s, %%%s],",
          (seç koşul: evet: 'true', varsayılan: 'false'),
          Pi->Son->Öz->Ad->_harfler); 
        //İmge = mantıkÇıktısı(Üretim, Kutu->Öz, Son, koşul);
      }
      değilse: 
      {
        her Kutu: 
        {
          İmge = mantıkÇıktısı(Üretim, Kutu->Öz, Kutu->Sonraki, koşul);
          Kutu = Kutu->Sonraki;
        }  
      }
      dön İmge;
    seçim imge::Özellik::I_Kesit:  

      eğer Son: 
      {
        Üretim->Bölüm->Genel()->Yaz(
        " [%s, %%%s],",
        (seç koşul: evet: 'true', varsayılan: 'false'),
        İmge->Ad->_harfler); 
        İmge = Girdi;
      }
      değilse: 
      {
        Üretim->Bölüm->Genel()->Yaz(
        " [%%%d, %%%s]",
        Girdi->Nesne->no,
        İmge->Ad->_harfler); 
        İmge = Girdi;
      }

  }
}

