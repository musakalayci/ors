küresel iş 
Sabitİşlem 
  Üretim   *üretim::t,
  SolNesne *nesne::t,
  SağNesne *nesne::t, 
  işlem     tam : *nesne::t 
{
  türNo := SolNesne->Özet->No();
  //i::Yaz("evet sabit\n");
  durum SolNesne->Atıf->özellik: 
  {
    seçim imge::Özellik::Sayı: 
      Sİmgesi := imge::YeniSabit(Üretim->Bölüm->Hafıza, 0, türNo);
      Sİmgesi->nesne.AtıfsızNakil(SolNesne); 
      Sİmgesi->özellik = imge::Özellik::Sayı;
      sağ  := SağNesne->Atıf->SayıdanSabit(); 
      sol := SolNesne->Atıf->içerik.sayı.içerik._t32; 
      ss := SağNesne->Atıf->T32ye(Üretim); 
      Sİmgesi->içerik.sayı = SolNesne->Atıf->içerik.sayı; 
      Sayı := &Sİmgesi->içerik.sayı;
      durum türNo: 
      {
        seçim simge::Terim::tamlar():
          durum işlem: 
          {
            seçim simge::Özellik::Yüzde: 
              eğer sağ == 0: 
                dön bildiri::Nesne(
                  Üretim->Bölüm->Kaynak, 
                  bildiri::Sistem::Aritmetik, 
                  &SolNesne->Atıf->konum,
                  "Sıfıra bölünemez.");
              Sayı->içerik._t64 %= sağ;
            seçim simge::Özellik::Artı,
                  simge::Özellik::Artı_Eşit: 
              Sayı->içerik._t64 += sağ;
            seçim simge::Özellik::Çarp_Eşit,
                  simge::Özellik::Yıldız:   
              Sayı->içerik._t64 *= sağ;
            seçim simge::Özellik::Bölü,
                  simge::Özellik::Böl_Eşit:  
              eğer !sağ: 
                dön bildiri::Nesne(
                  Üretim->Bölüm->Kaynak, 
                  bildiri::Sistem::Aritmetik, 
                  &SolNesne->Öz->konum,
                  "Sıfıra bölünemez.");
              Sayı->içerik._t64 /= sağ;
            seçim simge::Özellik::Eksi,
                  simge::Özellik::Eksi_Eşit:
              Sayı->içerik._t64 -= sağ;
            seçim simge::Özellik::Sağa_Kaydır,
                  simge::Özellik::Sağa_Kaydır_Eşit:  
                 // stdio::printf('moses');              
              Sayı->içerik._t64 >>= sağ;
            seçim simge::Özellik::Sola_Kaydır,
                  simge::Özellik::Sola_Kaydır_Eşit:           
              Sayı->içerik._t64 <<= sağ; 
            seçim simge::Özellik::T_Ve,
                  simge::Özellik::T_Ve_Eşit: 
              Sayı->içerik._t64 &= sağ;
            seçim simge::Özellik::T_Veya,
                  simge::Özellik::T_Veya_Eşit: 
              Sayı->içerik._t64 |= sağ;
            seçim simge::Özellik::Şapka, simge::Özellik::T_Ters_Veya_Eşit:  
              Sayı->içerik._t64 ^= sağ;
            varsayılan: 
              dön bildiri::Nesne(
                    Üretim->Bölüm->Kaynak, 
                    bildiri::Sistem::Aritmetik, 
                    &SolNesne->Atıf->konum,
                    "Bilinmeyen işlem."); 
          }
        seçim simge::Terim::doğallar():
          durum işlem: 
          {
            seçim simge::Özellik::Yüzde: 
