küresel iş SabitSayıMı Sol *t, Sağ *t : eh 
{
  eğer Sol->Öz && Sağ->Öz: 
  {
    durum Sol->Öz->özellik: 
    {
      seçim imge::Özellik::SabitSayı,
            imge::Özellik::Sayı: 
        durum Sağ->Öz->özellik: 
        {
          seçim imge::Özellik::SabitSayı,
                imge::Özellik::Sayı: 
            dön evet;
        }
    }
  }
  dön hayır;
}



