Derleme *t 
küresel iş Bildiri Bölüm *bölüm::t, tamamlanma tam, ürünTamamlanma tam 
{
  _boşluk := '                                                                                                                                ';
  Bellek  := Derleme->Döküm->Bellek;
  Argüman := &Bölüm->Üretim->Argüman->değişken.ilk; 
  Argüman->Sıfırla();
  Bellek->Sıfırla(); 
  Bölüm->Ürün->Uzantı(Bellek);
  Bölüm->Kütüphane->Öz->Uzantı(Argüman);
  i::Yaz("  |%3d%% %s%s%s>", 
    Yüzde(Derleme->bölümler.boyut, tamamlanma),
    renk::koyuKırmızı, 
    Bellek->_veri, 
    renk::_son);
  i::Yaz("%s%s%s", 
    renk::bordo, 
    Argüman->_veri, 
    renk::_son);
  i::Yaz(" >> %s%s%s\n", 
    renk::koyuMavi,
    Bölüm->yollar->nesne._dizi,
    renk::_son);
}

Derleme *t 
küresel iş BildiriÜrün Ürün *ürün::t, tamamlanma tam
{
  Bellek  := Derleme->Döküm->Bellek;
  Ürün->Uzantı(Bellek);
  i::Yaz("|%3d%% %s'%s%s%s' üretiliyor:%s\n", 
    Yüzde(Derleme->ürünler.boyut, tamamlanma),
    renk::sarı,
    renk::koyuKırmızı,
    Bellek->_veri,
    renk::sarı,
    renk::_son);
}

Derleme *t 
küresel iş kaynaklarıGez Kaynak *kaynak::t 
{
  değer Ast *kaynak::t = boş; 
  durum Kaynak->özellik: 
  {
    seçim kaynak::Özellik::Dosya, 
          kaynak::Özellik::Kök: 
     // i::Yaz("----> %d, %d, %s %p\n", Kaynak->no, Kaynak->sıra, Kaynak->Ad->_harfler, Kaynak->Ürün); 
      
      her i := 0; i < Kaynak->kaynaklar.boyut; i++: 
      {
        Ast = Kaynak->kaynaklar.Nesneler[i]; 
        Derleme->kaynaklarıGez(Ast);
      }
      eğer Kaynak->Ürün: 
      {
        //Derleme->Döküm->Ürün(Kaynak->Ürün, 0, '\n');
        Derleme->ürünler.Ekle(Kaynak->Ürün);
      }
  }
  
}

Derleme *t 
küresel iş 
başlat 
{
  değer Ast *kaynak::t = boş; 
  Bellek := Derleme->Döküm->Bellek; 
  değer Çözümleme *çözümleme::t = boş;
  her i := (Derleme->hafızalar.boyut -1); i >= 0 ; i--:
  {
    Hafıza := Derleme->hafızalar.Nesneler[i];
    Ast     = Hafıza->Kaynak; 
    Çözümleme = Hafıza->Çözümleme;
    Bellek->Sıfırla();
    Ast->Uzantı(Bellek);
    i::Yaz("%s%d: %s bölümü çözümleniyor.%s\n",
      renk::mavi,
      Hafıza->no,
      Bellek->_veri, 
      renk::_son);
    Çözümleme->Başlat(Hafıza->Kaynak); 
  }
  
  eğer Derleme->d: 
      dön;
  i::Yaz("%s'%s' derlemesi birimleri çözümlendi:%s\n", 
    renk::sarı, 
    Derleme->Kaynak->Ad->_harfler, 
    renk::_son); 
  değer Bölüm *bölüm::t = boş; 
  değer Ürün  *ürün::t = boş;
  her i := 0; i < Derleme->bölümler.boyut; i++: 
  {
    Bölüm = Derleme->bölümler->Nesneler[i];
    Bölüm->Derinlik();
    Ürün = ürün::Bul(Bölüm->Kütüphane); 
    
    eğer Ürün: 
    {
      Bölüm->Ürün = Ürün; 
      Ürün->Ekle(Bölüm);
    } 
    değilse: 
      i::Hata("sorunlu üretim.");
    
  }
  Derleme->bölümler.Sırala();
  
  Şuan := Derleme->ÜrünSözlüğü->Baş; 
  her Şuan: 
  {
    Ürün = Şuan->Öz; 
    i::Yaz("ürün %d, %s\n", Ürün->no, Ürün->Ad->_harfler);
    Şuan = Şuan->Sonraki;
  }

  Derleme->kaynaklarıGez(Derleme->Kaynak);
  
  

  her i := 0; i < Derleme->ürünler.boyut; i++: 
  {
    Ürün = Derleme->ürünler.Nesneler[i];  
    i::Yaz("->ürün %d, %s\n", Ürün->no, Ürün->Ad->_harfler); 
    Ürün->Yapılandır(Derleme);
  }
  değer Gelen *imge::t = boş;
  her i := 0; i < Derleme->ürünler.boyut; i++: 
  {
    Ürün = Derleme->ürünler.Nesneler[i];
    her j := 0; j < Ürün->Bölümler->boyut; j++: 
    {
      Bölüm = Ürün->Bölümler->Nesneler[j];
      Gelen = Bölüm->İşlemleriEkle(Derleme);
      eğer Gelen:
      {
        durum Gelen->özellik: 
        {
          seçim imge::Özellik::Hata:
            i = Derleme->ürünler.boyut;
            //i::Acil("hobaaelimkamaaaaaaakaaaaaaaaaaaaaaaa");
            son;
          
        }
      }
      değilse: 
        i::Yaz("------ sorunluuu\n");
    }
  }
  i::Yaz("%s'%s' derlemesi öntanımlamaları gerçekleştiriliyor:%s\n", 
    renk::sarı, 
    Derleme->Kaynak->Ad->_harfler, 
    renk::_son); 
  her i := 0; i < Derleme->ürünler.boyut; i++: 
  {
    Ürün = Derleme->ürünler.Nesneler[i];
    her j := 0; j < Ürün->Bölümler->boyut; j++: 
    {
      Bölüm = Ürün->Bölümler->Nesneler[j];
      Gelen = Bölüm->ÖnTanım(Derleme);
      eğer Gelen:
      {
        durum Gelen->özellik: 
        {
          seçim imge::Özellik::Hata:
            i = Derleme->ürünler.boyut;
            //i::Acil("hobaaelimkamaaaaaaakaaaaaaaaaaaaaaaa");
            son;
          
        }
      }
      değilse: 
        i::Yaz("------ sorunluuu\n");
    }
  }
  değer Bölümler *bölüm::bölümler = boş;
  t := 0;
  i::Yaz("%s'%s' derlemesi birimleri üretiliyor:%s\n", 
    renk::sarı, 
    Derleme->Kaynak->Ad->_harfler, 
    renk::_son); 
  
  her i := 0; i < Derleme->ürünler.boyut; i++: 
  {
    Ürün = Derleme->ürünler.Nesneler[i]; 
    Derleme->BildiriÜrün(Ürün, i+1);
    her j := 0; j < Ürün->Bölümler->boyut; j++: 
    {
      Bölüm = Ürün->Bölümler->Nesneler[j];
      Gelen = Bölüm->Üretim->Birim(Bölüm);
      durum Gelen->özellik: 
      {
        seçim imge::Özellik::Hata: 
          son;
        varsayılan: 
          t++;
          Bölüm->Nesne();
          eğer Ürün->Bölüm == Bölüm: 
          {
            Derleme->Bildiri(Bölüm, t, j+1);
          }
          değilse: 
          {
            Derleme->Bildiri(Bölüm, t, j+1);
          }
      }
    }
    Ürün->Üret();
  }

  
