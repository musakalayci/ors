  tür vector dizi::k't32;

  tür vv 
  {
    boyut tam; 
    hacim tam;
    Nesneler **vector;
  }

  öz *vv   
  küresel iş Ekle Vector *vector 
  {
    eğer öz->boyut == öz->hacim:
    {
      öz->hacim *= 2;
      yenile(&öz->Nesneler, öz->hacim);
    }
    öz->Nesneler[öz->boyut] = Vector; 
    öz->boyut++;
  } 

  öz *vv  
  küresel  iş Yapılandır hacim tam 
  {
    öz->hacim    = hacim;
    öz->Nesneler = temiz(%*öz->Nesneler[hacim]); 
    öz->boyut    = 0;
  }

  küresel iş min a tam, b tam: tam 
  {
    eğer a < b: 
      dön a; 
    dön b;
  }


  
  
  tür kuyruk dizi::zincir::k'tam;

  küresel iş tapoSort 
    Bağlar *vv : *vector 
  {
    boyut := Bağlar->boyut; 

    İndegree := temiz(vector);
    İndegree->Yapılandır(16); 
    Kuyruk := temiz(kuyruk);
    Kuyruk->Yapılandır();
    Sıralama := temiz(vector);
    Sıralama->Yapılandır(16);

    her i:= 0; i < boyut; i++: 
    {
      Ast := Bağlar->Nesneler[i]; 
      her j := 0; j < Ast->boyut; j++: 
      {
        aa := Ast->Nesneler[j];
        k := İndegree->Nesneler[aa];
        İndegree->Nesneler[aa] = k + 1;
      }
    }



    her i := 0; i < boyut; i++: 
    {
      i::Yaz("i: %d degree: %d\n", i, İndegree->Nesneler[i]);
      eğer İndegree->Nesneler[i] == 0: 
      {
        i::Yaz("i %d ekleniyor.\n", i);
        Kuyruk->Ekle(i);
      }
    }
    i::Yaz("Kuyruk->boyut %d\n", Kuyruk->boyut);
    her Kuyruk->boyut: 
    {
      top := Kuyruk->ÖndenÇıkar();
      içerik := top->Öz; 
      sil top;
      Sıralama->Ekle(içerik); 
      Ast := Bağlar->Nesneler[içerik]; 
      her j := 0; j < Ast->boyut; j++: 
      {
        next := Ast->Nesneler[j];
        a :=  İndegree->Nesneler[next];
        İndegree->Nesneler[next] = a -1;
        eğer İndegree->Nesneler[next] == 0: 
        {
          Kuyruk->Ekle(next);
        }
      }
    }
    Kuyruk->Temizle(); 
    sil Kuyruk; 
    İndegree->Temizle();
    sil İndegree;
    dön Sıralama;
  } 

 

