 

Ayıklama *t 
küresel iş BölümBildirisi 
{
  dwarf    := Ayıklama->No(); 
  ayıklama := Ayıklama->No();
  wchar    := Ayıklama->No(); 
  pic      := Ayıklama->No();
  pie      := Ayıklama->No();
  uwTable  := Ayıklama->No();
  frame    := Ayıklama->No();
  clang    := Ayıklama->No(); 

  Ayıklama->çıktı.genel.Yaz(
    "declare void @llvm.dbg.declare(metadata, metadata, metadata)\n"); 
  Ayıklama->çıktı.genel.Yaz(
    "declare void @llvm.dbg.value(metadata, metadata, metadata)\n"); 
  Ayıklama->çıktı.genel.Yaz(
    "declare void @llvm.dbg.assign (metadata, metadata, metadata, metadata, metadata, metadata)\n");
  Ayıklama->çıktı.genel.Yaz("!llvm.ident = !{!%u}\n", clang); 
  Ayıklama->çıktı.genel.Yaz("!llvm.module.flags = !{!%d, !%d, !%d, !%d, !%d, !%d, !%d}\n", 
    dwarf, ayıklama, wchar, pic, pie, uwTable, frame); 
  Ayıklama->çıktı.genel.Yaz("!%d = !{i32 7, !\"Dwarf Version\", i32 4}\n", dwarf);
  Ayıklama->çıktı.genel.Yaz("!%d = !{i32 2, !\"Debug Info Version\", i32 3}", ayıklama);
  Ayıklama->çıktı.genel.Yaz("!%d = !{i32 1, !\"wchar_size\", i32 4}\n", wchar);
  Ayıklama->çıktı.genel.Yaz("!%d = !{i32 7, !\"PIC Level\", i32 2}\n", pic);
  Ayıklama->çıktı.genel.Yaz("!%d = !{i32 7, !\"PIE Level\", i32 2}\n", pie);
  Ayıklama->çıktı.genel.Yaz("!%d = !{i32 7, !\"uwtable\", i32 2}\n", uwTable);
  Ayıklama->çıktı.genel.Yaz("!%d = !{i32 7, !\"frame-pointer\", i32 2}\n", frame);
  Ayıklama->çıktı.genel.Yaz("!%d = !{!\"%s\"}\n", clang, Ayıklama->Bölüm->Üretim->Derleme->yerelleştirme.ClangSistem->_harfler);

}


Ayıklama *t 
küresel iş Kaynak Aranan *kaynak::t: tam
{
  
  Bölüm := Ayıklama->Bölüm; 
  Kaynak := Bölüm->Kütüphane->Kaynak; 
  eğer Aranan: 
    Kaynak = Aranan;
 // i::Yaz("kaynak sırası: %d\n", Kaynak->sıra);
  d := Ayıklama->Kaynaklar->Ara(Kaynak->sıra); 
  İlk    := &Bölüm->Üretim->Bellekler->ilk; 
  İkinci := &Bölüm->Üretim->Bellekler->ikinci;
  eğer d: 
    dön d; 
  değilse: 
  {
    d = Ayıklama->No();
    Ayıklama->Kaynaklar->Ekle(Kaynak->sıra, d);
    durum Kaynak->özellik: 
    {
      seçim kaynak::Özellik::Dosya, kaynak::Özellik::Kök:
        Kaynak->Yol->Ascii(&Bölüm->Üretim->Bellekler->ilk);
        Ayıklama->çıktı.genel.Yaz( "!%u = !DIFile(\n"
                                  "  filename: \"< unknown>\",\n"
                                  "  directory: \"%s\")\n", d, İlk->_veri);
      seçim kaynak::Özellik::Belge:
      Kaynak->Yol->Ascii(İlk); 
      Bölüm->Üretim->Kaynak->Yol->Ascii(İkinci);
      Ayıklama->çıktı.genel.Yaz( 
        "!%u = !DIFile(\n filename: \"%s\",\n directory: \"%s\")\n", 
        d, 
        İlk->_veri,
         İkinci->_veri);
    }
    dön d;
  }
}

Ayıklama *t 
küresel iş Yapılandır 
{
  Ayıklama->Yapıtaşları();
  Ayıklama->BölümBildirisi(); 
  Ayıklama->no = Ayıklama->No();
  Ayıklama->çıktı.genel.Yaz("!llvm.dbg.cu = !{!%d}; %p, %d\n", Ayıklama->no, 
    Ayıklama->Bölüm->Kütüphane->Öz->konum.Kaynak,
    Ayıklama->Bölüm->Kütüphane->Öz->konum.satır); 
  belge := Ayıklama->Kaynak(Ayıklama->Bölüm->Kütüphane->Öz->konum.Kaynak);
  Ayıklama->kaynak = belge;
  Ayıklama->çıktı.genel.Yaz(
    "!%u = distinct !DICompileUnit(\n  language: "
    "DW_LANG_C_plus_plus_11, "
    "\n  file: !%u, "
    "\n  producer: \"%s\"," 
    "\n  isOptimized: false, "
    "\n  runtimeVersion: 0,"
    "\n  emissionKind: FullDebug, "
    "\n  splitDebugInlining: false,"
    "\n  nameTableKind: None)\n", 
    Ayıklama->no, belge, 
    Ayıklama->Bölüm->Üretim->Derleme->yerelleştirme.ClangSistem->_harfler); 

}



Ayıklama *t
küresel iş Başlat 
{
  Ayıklama->TürleriGez();
  Ayıklama->işlemleriGez();
}

Ayıklama *t 
küresel iş Atıf Aranacak *bölüm::t: tam 
{
  değer gelen tam = 0;
  eğer Aranacak: 
  {
    gelen = Ayıklama->Bölümler->Ara(Aranacak->no); 
    eğer gelen: 
      dön gelen;
  }
  Kök := Ayıklama->Bölüm->Üretim->Derleme->kökler.Kök; 
  değer imgeler imge::_imgeler =  {}; 
  imgeler.Yapılandır(32);
  Kütüphane := (seç !Aranacak: evet: Ayıklama->Bölüm->Kütüphane, varsayılan: Aranacak->Kütüphane); 
  Şuanki    := Ayıklama->Bölüm; 
  üst := 0;
  her Kütüphane: 
  {
    imgeler.Ekle(Kütüphane->Öz);
   // i::Yaz("-> %s: %d\n", Kütüphane->Öz->Ad->_harfler, Kütüphane->Bölüm->no);
    Kütüphane = Kütüphane->Üst;
  }
  //i::Yaz("\n");
  her i := (imgeler.boyut-1); i >= 0; i--: 
  {
    Kütüphane = imgeler.Nesneler[i]->içerik.Birim; 
    Şuanki    = Kütüphane->Bölüm;
    gelen     = 0;
    gelen     = Ayıklama->Bölümler->Ara(Kütüphane->no);
    
    eğer gelen: 
    {
      üst = gelen;
    }
    değilse: 
    {
      gelen = Ayıklama->No(); 
      Bellek := &Ayıklama->Bölüm->Üretim->Bellekler->ilk; 
      Bellek->Sıfırla(); 
      Bellek->Yaz('!%d', üst); 
      _veri := Bellek->_veri;
      Ayıklama->çıktı.genel.Yaz(
        "!%d = !DINamespace(name:\"%s\", scope: %s);  %d, %d\n",
          gelen, 
          Kütüphane->Öz->Ad->_harfler, 
          (seç Kütüphane == Kök: 
            evet : 'null', 
            varsayılan: _veri),  
          Kütüphane->no, 
          Kök->no); 
      Ayıklama->Bölümler->Ekle(Kütüphane->no, gelen);
      üst = gelen;
    }
  } 
  imgeler.Temizle();
  dön üst;
}