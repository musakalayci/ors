  sabit değer SIGUSR2   t32 = 12;
  sabit değer SIGPIPE   t32 = 13;
  sabit değer SIGALRM   t32 = 14;
  sabit değer SIGTERM   t32 = 15;
  sabit değer SIGSTKFLT t32 = 16;
