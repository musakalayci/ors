birim bellek 
{
  dahili c::stdio;
  dahili c::stdarg;

  sanal tür k x
  {
    sıra  tam; 
    fark  tam;
    _veri x;
    _ek   mimari;
  }

  Bellek k'x
  sade sanal iş Sıfırla 
  {
    Bellek.sıra = 0_st32; 
    Bellek._veri[0] = 0_st8;
  } 


  Bellek k'x
  sade sanal iş Ekle ek t8 
  {
    Bellek._veri[Bellek.sıra] = ek; 
    Bellek.sıra++;
    Bellek.fark--;
    Bellek.Sonlandır();//sonlandırma
  } 

  Bellek k'x
  sade sanal iş Sonlandır 
  {
    D64 := <*d64>(&Bellek._veri[Bellek.sıra]);
    *D64 = 0;
  } 

  Bellek k'x 
  sade sanal iş Başı : *t8 
  {
    dön &Bellek._veri[0];
  }

  Bellek k'x
  sade sanal iş Sonu : *t8 
  { 
    dön &Bellek._veri[Bellek.sıra];
  } 

  

  Bellek *k'x
  küresel sanal iş Yaz Biçim *metin, _argümanlar ... : tam
  {
    //b := @Bellek->_veri;
    //stdio::printf('bellek boyutu: %lu\n', b);
    fark := (Bellek->Sınır() - <d64>Bellek->sıra);
    eğer fark > 0: 
    {
      stdarg::va_start(_argümanlar);
      gelen := stdio::vsnprintf(
        &Bellek->_veri[Bellek->sıra], 
        fark, 
        Biçim->_harfler, 
        _argümanlar);
      stdarg::va_end(_argümanlar);
      Bellek->sıra += gelen;
      Bellek->fark = (<t32>@Bellek->_veri - Bellek->sıra);
      //stdio::printf('veri: -%s- konum%p\n', Bellek->_veri, _argümanlar); 
      dön gelen;
    } 
    dön 0;
  }
  
  Bellek *k'x 
  bağımsız uygulamalı küresel sanal iş Yeni : *k'x 
  {
    Y := temiz(%*Bellek); 
    Y->Sıfırla(); 
    //stdio::printf('bellek boyutu: %p\n', Bellek);
    dön Y; 
  }
  
  uygulamalı tür t     k't8[4096];
  uygulamalı tür b64   k't8[64];
  uygulamalı tür b128  k't8[128];
  uygulamalı tür b256  k't8[256];
  uygulamalı tür b512  k't8[512];
  uygulamalı tür b1024 k't8[1024]; 
  uygulamalı tür b2048 k't8[2048];

  küresel iş Yeni : *t 
  {
    Bellek := temiz(t);
    Bellek->Sıfırla();
    dön Bellek;
  } 

  Bellek k'x 
  küresel sade sanal iş Sınır : d64 
  {
    dön @Bellek._veri; 
  }

  birim örnek 
  {
    dahili merkez::bellek;
    dahili merkez::iletişim: i;
    küresel iş Başlat  
    {
      Bellek := bellek::t::Yeni(); 
      geçmiş := 'lorem ipsum sir dolor';

      B2048 := bellek::b2048::Yeni();

      B1024 := bellek::b1024::Yeni();
      B512 :=  bellek::b512::Yeni();
      B256 := bellek::b256::Yeni();
      B128 := bellek::b128::Yeni();
      değer B64 *bellek::b64 = bellek::b64::Yeni();

      Bellek->Yaz("Deneme 4096: %s %lu", geçmiş, Bellek->Sınır()); 
      B2048->Yaz("Deneme 2048: %s %lu", geçmiş, B2048->Sınır());
      B1024->Yaz("Deneme 1024: %s %lu", geçmiş, B1024->Sınır());
      B512->Yaz("Deneme  512: %s %lu", geçmiş, B512->Sınır());
      B256->Yaz("Deneme  256: %s %lu", geçmiş, B256->Sınır()); 
      B128->Yaz("Deneme  128: %s %lu", geçmiş, B128->Sınır());
      B64->Yaz("Deneme   64: %s %lu", geçmiş, B64->Sınır());

      //Bellek->Yaz("cidden mi la");

      i::Yaz("\nBellek yazılan : %s\n", Bellek->_veri, Bellek->sıra);  
      i::Yaz("B2048  yazılan : %s [%d]\n", B2048->_veri, B2048->sıra); 
      i::Yaz("B1024  yazılan : %s [%d]\n", B1024->_veri, B1024->sıra); 
      i::Yaz("B512   yazılan : %s [%d]\n", B512->_veri, B512->sıra); 
      i::Yaz("B256   yazılan : %s [%d]\n", B256->_veri, B256->sıra); 
      i::Yaz("B128   yazılan : %s [%d]\n", B128->_veri, B128->sıra); 
      i::Yaz("B64    yazılan : %s [%d]\n", B64->_veri, B64->fark); 

      sil Bellek; 
      sil B2048; 
      sil B1024; 
      sil B512; 
      sil B256; 
      sil B128; 
      sil B64;
    }
  } 

  Bellek *k'x
  küresel sanal iş Geçir Metin *metin: tam 
  {
    
    dön Metin->boyut;
  }
}