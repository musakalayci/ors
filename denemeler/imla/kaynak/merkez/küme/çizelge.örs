    Sözlük->Nesneler[sıra] = Hücre;
    Sözlük->nüfus++;
    eşik := Sözlük->hacim / 2;
    eğer Sözlük->nüfus > eşik: 
      Sözlük->_yenile(); 
    dön Ek;
  }

