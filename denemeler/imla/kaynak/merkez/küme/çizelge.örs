    Hücre->dolama = Sözlük->İşlem(<*d8>&Hücre->no);
    Hücre->sıra   = Sözlük->DiziSırası(Sözlük->hacim, Hücre->dolama); 
    durum Sözlük->nüfus: 
    {
      seçim 0: 
        Sözlük->Son = Hücre;
        Sözlük->Baş = Hücre;
      varsayılan: 
        Hücre->Önceki        = Sözlük->Son;
        Sözlük->Son->Sonraki = Hücre;
        Sözlük->Son          = Hücre;
    }
    dön Hücre;
