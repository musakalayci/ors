  Sözlük *k'x
  sanal küresel iş Temizle 
  {
    Üye := Sözlük->Baş;
    Ast := Sözlük->Baş; 
    Geçici := Sözlük->Baş; 
    her i := 0; i < Sözlük->hacim; i++: 
    {
      Üye = Sözlük->Nesneler[i]; 
      eğer Üye: 
      {
        Ast = Üye->Sıradaki;
        Geçici = Üye->Sıradaki; 
        her Ast: 
