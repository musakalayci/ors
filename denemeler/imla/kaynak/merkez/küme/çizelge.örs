  Sözlük *k'x
  sanal iş _yenile 
  {
    Eskiler := <şey>Sözlük->Nesneler; 
    eski := Sözlük->hacim;
    eşik := Sözlük->hacim / 2;
    Sözlük->işlemlendir();
    Sözlük->bilgi(); 
    Sözlük->hacim = Sözlük->hacim *2; 
    
    Sözlük->Nesneler = temiz(%*Sözlük->Nesneler[Sözlük->hacim]); 
    Sözlük->nüfus = 0; 
    Ast := Sözlük->Baş;
    her Ast: 
    {
      Sözlük->hücreYenile(Ast);
      Ast = Ast->Sonraki;
    }
    sil Eskiler;
  }

