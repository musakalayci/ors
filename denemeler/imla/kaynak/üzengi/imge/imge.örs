Ç *çizelge 
bağımsız küresel iş Yeni : *çizelge
{
  Çizelge := temiz(çizelge);
  Sütunlar := temiz(sözlük);
  Satırlar := temiz(imgeler);
  Çizelge->Satırlar = Satırlar;
  Çizelge->Sütunlar = Sütunlar;
  Satırlar->Yapılandır(16);
  Sütunlar->Yapılandır(16);
  dön Çizelge;
}

