      Bellek->Yaz("bilinmeyen");
  }
  Bellek->Yaz("%s ", renk::_son);
}



Üzengi *t 
iş HataVer Konum *imge::konum, kod tam : *imge::t 
{
  Üzengi->durumu = kod; 
  Hata := Üzengi->YeniImge(imge::Özellik::Hata); 
  Hata->içerik.hata = kod;
  eğer Konum:
    Hata->konum = *Konum;
  Üzengi->HataBildirisi(Hata);
  dön Hata;
}
