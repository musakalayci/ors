Üzengi *t 
küresel iş HataBildirisi Hata *imge::t 
{
  Bellek := Üzengi->Bellek;
  Bellek->Sıfırla();
  i := Hata->içerik.hata;
  Bellek->Yaz("%shata[%d]::", renk::kırmızı, Hata->içerik.hata);
  durum Hata->içerik.hata:
  {
    seçim Hata::Dizi_Türü:
      Bellek->Yaz("dizi_türü");
    seçim Hata::Bulunamadı:
      Bellek->Yaz("Bulunamadı");
    seçim Hata::Beklenmeyen:
      Bellek->Yaz("beklenmeyen");
    seçim Hata::Istenmeyen_Noktalama:
      Bellek->Yaz("istenmeyen_noktalama");
    seçim Hata::Tanım_Bekleniyor:
      Bellek->Yaz("tanım_bekleniyor");
    seçim Hata::Dizi_Özellik:
      Bellek->Yaz("dizi_özellik");
    seçim Hata::Söz_Dizimi:
      Bellek->Yaz("söz_dizimi");
    seçim Hata::Söz_Dizimi_Dizi:
      Bellek->Yaz("söz_dizimi_dizi");
    seçim Hata::Çizelge_İsim:
      Bellek->Yaz("çizelge_isim");
    seçim Hata::Çizelge_Üyeler:
      Bellek->Yaz("çizelge_üyeler");
    seçim Hata::Virgül_Bekleniyor:
      Bellek->Yaz("virgül_bekleniyor");
    seçim Hata::Beklenmeyen_Tür:
      Bellek->Yaz("beklenmeyen_tür");
    seçim Hata::Noktalı_Virgül_Bekleniyor:
      Bellek->Yaz("noktalı_virgül_bekleniyor");
