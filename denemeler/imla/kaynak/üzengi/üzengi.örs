Uzengi *t 
iş Devam : eh 
{
  değer d eh = evet;  
  durum Uzengi->ibre.Şuan->özellik: 
  {
    seçim imge::Özellik::Son: 
      d = hayır;
    seçim imge::Özellik::Hata:  
      d = hayır; 
    varsayılan: 
      d = evet; 
  }
  dön d;
}

