birim örnek 
{
  dahili merkez::iletişim: i;
  dahili merkez::belge;
  dahili merkez::bellek;
  dahili üzengi;
  küresel iş Başlat 
  {
    _yol := './denemeler/ıvır_zıvır/dd.uzn';
    değer belge belge::baytlar = boş;
    hata := belge.Yapılandır(_yol); 
    eğer hata: 
      dön;
    i::Yaz("%s", belge.Dizi);
    değer Üzengi üzengi::t = boş;
    Üzengi.Yapılandır(&belge); 
    //Üzengi.deneme();
    Gelen := Üzengi.Çözümle(); 
    durum Gelen->özellik:
    {
      seçim üzengi::imge::Özellik::Hata:
        Gelen->Bilgi(&Üzengi, 0); 
      varsayılan:
        Gelen->Bilgi(&Üzengi, 0);
    }
    i::Yaz("arama:\n");
    Bulunan := Üzengi.Ara('özelleştirme.ad');
    eğer Bulunan:
      Bulunan->Bilgi(&Üzengi, 0);
    i::Yaz("bulunan: %p", Bulunan);
    Üzengi.Temizle();
    belge.Temizle();
  }
}