  dön (Üzengi->ibre.Şuan);
}

Uzengi *t 
iş YeniTanım özellik tam, içerik şey: *imge::t
{
  Imge := Uzengi->YeniImge(özellik); 
  Imge->içerik.Genel = içerik; 
  dön Imge;
}


