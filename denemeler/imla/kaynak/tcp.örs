iş HandleTcpClient clientSocket tam 
{
  değer _buffer t8[512]; 
  numberOfBytesReceived := s::recv(clientSocket, _buffer, 512, 0);
  eğer numberOfBytesReceived < 0: 
    DieWithSystemMessage("recv failed !!");  
  _buffer[numberOfBytesReceived+1] = 0;
  iletişim::Yaz("client send: '%s'\n", _buffer);
  her numberOfBytesReceived > 0: 
  {
    değer numberOfBytesSent tm = s::send(clientSocket, _buffer, numberOfBytesReceived, 0); 
    eğer numberOfBytesSent < 0: 
      DieWithSystemMessage("send() failed"); 
    eğer ki numberOfBytesReceived != numberOfBytesSent: 
      DieWithSystemMessage("send failed, unexpected number of bytes"); 
    değilse:
    {
      numberOfBytesReceived = s::recv(clientSocket, _buffer, 512, 0);  
      _buffer[numberOfBytesReceived+1] = 0;
      iletişim::Yaz("client send: '%s'\n", _buffer);
    }
  }
  iletişim::Yaz("closing connection\n");
  unistd::close(clientSocket);
}

