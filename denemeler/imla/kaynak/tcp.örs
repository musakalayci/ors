iş setupTcpServerSocket _service *t8: tam 
{
  değer addressCriteria netdb::addrinfo = {};
  addressCriteria.ai_family = s::Af::Unspec; 
  addressCriteria.ai_flags  = netdb::Ai::Passive | netdb::Ai::CannonName; 
  addressCriteria.ai_socktype = s::Type::Stream; 
  addressCriteria.ai_protocol = in::Proto::Tcp; 

  değer ServerAddresses *netdb::addrinfo = boş; 
  d := netdb::getaddrinfo('127.0.0.1', _service, &addressCriteria, &ServerAddresses); 
  eğer d != 0:
    DieWithSystemMessage("getaddrinfo failed.");
  serverSocket := -1; 
  her Address := ServerAddresses; Address; Address = Address->ai_next: 
  {
    serverSocket = s::socket(Address->ai_family, Address->ai_socktype, Address->ai_protocol); 
    eğer serverSocket < 0: 
      devam; 
    eğer (s::bind(serverSocket, Address->ai_addr, Address->ai_addrlen) == 0) 
      && (s::listen(serverSocket, 5) == 0):
    {
      değer localAddress s::sockaddr_storage = {}; 
      addressSize := @localAddress; 
      eğer s::getsockname(serverSocket,
        <*s::sockaddr>&localAddress, 
        &addressSize) < 0: 
        DieWithSystemMessage("getsockname failed."); 
      stdio::fputs('binding to: ', stdio::stdout); 
      printSocketAddr(<*s::sockaddr>&localAddress, stdio::stdout); 
      stdio::fputs('\n', stdio::stdout);
      
    }
    değilse: 
    {
      unistd::close(serverSocket); 
      serverSocket = -1; 
    }
  }
  netdb::freeaddrinfo(ServerAddresses);
  dön serverSocket;
} 

