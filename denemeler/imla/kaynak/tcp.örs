iş SigIoHandler sig tam 
{
  değer numberOfBytesReceived tm = 1; 
  iletişim::Yaz("handling client:\n");
  her numberOfBytesReceived >= 0: 
  {
    değer clientAddress s::sockaddr_storage; 
    clientAddressLength := @clientAddress; 
    değer _buffer t8[256]; 
    numberOfBytesReceived = s::recvfrom(serverSocket, _buffer, 128, 0, <*s::sockaddr>&clientAddress, &clientAddressLength); 
    eğer numberOfBytesReceived < 0: 
    {
      eğer e::no() != e::No::Again: 
        DieWithSystemMessage("recvfrom() failed."); 
    }
    değilse: 
    {
      _buffer[numberOfBytesReceived] = 0;
      .fprintf(.stdout, 'Handling client: %s', _buffer);
      printSocketAddr(<*s::sockaddr>&clientAddress, .stdout); 
      .fputs('\n', .stdout); 
      numberOfBytesSent := s::sendto(
        serverSocket, 
        _buffer, 
        numberOfBytesReceived,
        0, 
        <*s::sockaddr>&clientAddress,
        clientAddressLength);
      eğer numberOfBytesSent < 0: 
        DieWithSystemMessage("sendto() failed."); 
      eğer numberOfBytesSent != numberOfBytesReceived: 
        DieWithSystemMessage("sendto unexpected number of bytes");
    }

  }
}

